# iData+ — env shembull për zhvillim lokal (Increment 1). PA sekrete reale.
# Postgres lokal ngrihet me:  docker compose up   (auth = trust, pa fjalëkalim).

# Lidhja me DB — pg i lexon këto variabla standarde:
PGHOST=localhost
PGPORT=5433
PGUSER=idata
PGDATABASE=idata

# API (NestJS) + web (Next.js):
API_PORT=3001
API_URL=http://localhost:3001

# Shënim: kredencialet reale të prodhimit mbahen JASHTË git (asnjë sekret këtu).
