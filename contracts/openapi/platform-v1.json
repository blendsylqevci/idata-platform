{
  "openapi": "3.1.1",
  "info": {
    "title": "Idata.Platform.Api | platform-v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/platform/status": {
      "get": {
        "tags": [
          "Idata.Platform.Api"
        ],
        "summary": "Statusi teknik i platformës (Bootstrap smoke slice).",
        "operationId": "GetPlatformStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/access-context": {
      "get": {
        "tags": [
          "AccessControlEndpoints"
        ],
        "summary": "Konteksti i qasjes i aktorit aktual (provider-neutral, redacted).",
        "operationId": "GetAccessContext",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessContextResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/memberships/{membershipId}/role": {
      "put": {
        "tags": [
          "AccessControlEndpoints"
        ],
        "summary": "Ndryshim idempotent i rolit të një membership-i (Idempotency-Key i detyrueshëm).",
        "operationId": "UpdateMembershipRole",
        "parameters": [
          {
            "name": "membershipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMembershipRoleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MembershipRoleResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccessContextResponse": {
        "required": [
          "userId",
          "businessId",
          "permissions",
          "identityStatus"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "businessId": {
            "type": "string",
            "format": "uuid"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "identityStatus": {
            "type": "string"
          }
        }
      },
      "MembershipRoleResponse": {
        "required": [
          "membershipId",
          "roleId",
          "version",
          "status"
        ],
        "type": "object",
        "properties": {
          "membershipId": {
            "type": "string",
            "format": "uuid"
          },
          "roleId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "PlatformCapabilitiesResponse": {
        "required": [
          "identity",
          "audit",
          "outbox",
          "observability"
        ],
        "type": "object",
        "properties": {
          "identity": {
            "type": "string"
          },
          "audit": {
            "type": "string"
          },
          "outbox": {
            "type": "string"
          },
          "observability": {
            "type": "string"
          }
        }
      },
      "PlatformStatusResponse": {
        "required": [
          "status",
          "apiVersion",
          "database",
          "capabilities"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "apiVersion": {
            "type": "string"
          },
          "database": {
            "type": "string"
          },
          "capabilities": {
            "$ref": "#/components/schemas/PlatformCapabilitiesResponse"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UpdateMembershipRoleRequest": {
        "required": [
          "roleId",
          "expectedVersion"
        ],
        "type": "object",
        "properties": {
          "roleId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Idata.Platform.Api"
    },
    {
      "name": "AccessControlEndpoints"
    }
  ]
}