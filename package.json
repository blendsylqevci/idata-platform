{
  "name": "idata-platform",
  "version": "0.0.0",
  "private": true,
  "description": "iData+ — platformë multi-tenant për KABI (qumështore) + PLANET (restorant). Walking skeleton.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "platform:restore": "dotnet restore src/platform --locked-mode",
    "platform:build": "dotnet build src/platform",
    "platform:test": "dotnet test src/platform --no-build",
    "platform:migrate": "dotnet run --project src/platform/Idata.Platform.DbMigrator -- migrate",
    "platform:migrate:status": "dotnet run --project src/platform/Idata.Platform.DbMigrator -- status",
    "contracts:generate": "dotnet build src/platform/Idata.Platform.Api && pnpm --filter @idata/platform-api-client generate",
    "contracts:drift-check": "pnpm contracts:generate && git diff --exit-code -- contracts/openapi packages/platform-api-client/src/generated",
    "backoffice:build": "turbo run build --filter=@idata/backoffice",
    "backoffice:test": "turbo run test --filter=@idata/backoffice",
    "verify:all": "pnpm build && pnpm typecheck && pnpm test && pnpm platform:build && pnpm platform:test && pnpm contracts:drift-check && pnpm backoffice:build && pnpm backoffice:test",
    "platform:migrate:reset:test-only": "dotnet run --project src/platform/Idata.Platform.DbMigrator -- down-to-zero"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.2.0"
    }
  }
}
