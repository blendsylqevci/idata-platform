<Project Sdk="Microsoft.NET.Sdk">
  <!-- Identity Presentation (B.2b + B.2c): siperfaqe interaksioni MINIMALE, server-rendered dhe first-party per authority-n (login + consent). -->
  <!-- B.2c shton thin controller-in e UserInfo (IMediator). Varet VETEM nga Application (+ framework-u ASP.NET Core + Mediator.Abstractions). -->
  <!-- Zero OpenIddict, zero ASP.NET Core Identity, zero Persistence, zero credential/store/rregull biznesi. -->
  <!-- Nuk eshte UI produkti, nuk eshte BFF dhe nuk zevendeson aplikacionet Angular/POS/mobile. -->
  <ItemGroup>
    <ProjectReference Include="..\Application\Idata.Platform.Modules.Identity.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- ADR-029 (B.2c): IMediator = surface i vetem i lejuar i controller-it UserInfo; pin-i EKZISTUES 3.0.2 (CPM), zero paketa tjeter. -->
    <PackageReference Include="Mediator.Abstractions" />
  </ItemGroup>
</Project>
