<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- API Host = composition root i modular monolith-it (ADR-024). -->
  <ItemGroup>
    <ProjectReference Include="..\Idata.Platform.Persistence\Idata.Platform.Persistence.csproj" />
    <ProjectReference Include="..\Modules\AccessControl\Application\Idata.Platform.Modules.AccessControl.Application.csproj" />
    <ProjectReference Include="..\Modules\AccessControl\Infrastructure\Idata.Platform.Modules.AccessControl.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\AccessControl\Presentation\Idata.Platform.Modules.AccessControl.Presentation.csproj" />
    <ProjectReference Include="..\Modules\Identity\Infrastructure\Idata.Platform.Modules.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\PlatformStatus\Application\Idata.Platform.Modules.PlatformStatus.Application.csproj" />
    <ProjectReference Include="..\Modules\PlatformStatus\Infrastructure\Idata.Platform.Modules.PlatformStatus.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\PlatformStatus\Presentation\Idata.Platform.Modules.PlatformStatus.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ADR-029: SourceGenerator-i i mediator-it VETEM ne outermost host. -->
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <!-- ADR-029: Scalar UI mbi OpenAPI — mapohet VETEM nen IsDevelopment(). -->
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Referencë direkte për të imponuar versionin e riparuar të varësisë
         transitive (shih Directory.Packages.props / GHSA-v5pm-xwqc-g5wc). -->
    <PackageReference Include="Microsoft.OpenApi" />
  </ItemGroup>
  <ItemGroup>
    <!-- Gjenerim ZYRTAR build-time i dokumentit OpenAPI (pa server, pa network);
         design-time only — nuk shkon ne output-in runtime. -->
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <PropertyGroup>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <!-- B.2a C1 (A1): hook-u automatik i paketës çaktivizohet dhe gjenerimi ZYRTAR
         (target-i i vetë paketës, komandë e pandryshuar) thirret nga target-i më poshtë
         me environment EKSPLICIT Development + zgjedhje eksplicite EphemeralKey, që
         host-i i tool-it (GetDocument.Insider → Program.Main deri te ApplicationStarted)
         të kalojë policy-në REALE të credentials (rruga standarde Development, jo
         flamur skip). Zero material kredencialesh: çelësat ephemeral gjenerohen në
         memorie brenda procesit të tool-it. Environment-i i build-it (p.sh.
         DOTNET_ENVIRONMENT=Production në CI) nuk ndikon dokumentin (AddOpenApi +
         transformer-at janë të pakushtëzuar); kontrata mbetet byte-identike. -->
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(BaseIntermediateOutputPath)openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name platform</OpenApiGenerateDocumentsOptions>
    <_IdataDotnetHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_IdataDotnetHost>
    <_IdataDotnetHost Condition="'$(_IdataDotnetHost)' == ''">dotnet</_IdataDotnetHost>
  </PropertyGroup>
  <ItemGroup>
    <!-- Environment-i EKSPLICIT i host-it design-time të OpenAPI-t: rruga standarde
         Development e policy-së (matrica reale vlerësohet), zero material sekret. -->
    <_IdataOpenApiDesignTimeEnvironment Include="DOTNET_ENVIRONMENT=Development" />
    <_IdataOpenApiDesignTimeEnvironment Include="ASPNETCORE_ENVIRONMENT=Development" />
    <_IdataOpenApiDesignTimeEnvironment Include="Identity__Authority__Issuer=https://localhost/" />
    <_IdataOpenApiDesignTimeEnvironment Include="Identity__Authority__Audiences__0=synthetic-openapi-design-time" />
    <_IdataOpenApiDesignTimeEnvironment Include="Identity__Authority__Jose__SignatureAlgorithms__0=RS256" />
    <_IdataOpenApiDesignTimeEnvironment Include="Identity__Authority__Jose__KeyManagementAlgorithms__0=RSA-OAEP" />
    <_IdataOpenApiDesignTimeEnvironment Include="Identity__Authority__Jose__ContentEncryptionAlgorithms__0=A256CBC-HS512" />
    <_IdataOpenApiDesignTimeEnvironment Include="Identity__Authority__ClockSkewSeconds=0" />
    <_IdataOpenApiDesignTimeEnvironment Include="Identity__Authority__Credentials__Development__Signing=EphemeralKey" />
    <_IdataOpenApiDesignTimeEnvironment Include="Identity__Authority__Credentials__Development__Encryption=EphemeralKey" />
  </ItemGroup>
  <!-- Njësoj si hook-u i paketës (BeforeTargets=Build, jo inner build), por përmes një
       msbuild-i të ngulitur që trashëgon environment-in eksplicit te Exec-i i tool-it. -->
  <Target Name="GenerateOpenApiDocumentsWithExplicitDevelopmentIdentity" BeforeTargets="Build" Condition="'$(OpenApiGenerateDocuments)' == 'true' AND ('$(TargetFramework)' == '' OR '$(TargetFrameworks)' == '')">
    <Exec Command="&quot;$(_IdataDotnetHost)&quot; msbuild &quot;$(MSBuildProjectFullPath)&quot; -t:GenerateOpenApiDocuments -p:Configuration=$(Configuration) -nologo -nr:false -v:minimal" EnvironmentVariables="@(_IdataOpenApiDesignTimeEnvironment)" LogStandardErrorAsError="true" />
  </Target>
  <Target Name="CopyPlatformOpenApiContract" AfterTargets="GenerateOpenApiDocuments" Condition="Exists('$(BaseIntermediateOutputPath)openapi/platform_platform-v1.json')">
    <!-- Emri kanonik i kontratës së commit-uar: contracts/openapi/platform-v1.json -->
    <Copy SourceFiles="$(BaseIntermediateOutputPath)openapi/platform_platform-v1.json"
          DestinationFiles="$(MSBuildThisFileDirectory)../../../contracts/openapi/platform-v1.json"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
