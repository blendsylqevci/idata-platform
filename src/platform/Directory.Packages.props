<Project>
  <!-- Central Package Management — çdo version vendoset VETËM këtu, i pin-uar
       ekzakt (pa wildcard); projektet referojnë paketat pa version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- ADR-029 Increment A: mediator MIT i pin-uar ekzakt (provenance: NuGet
         Mediator.Abstractions/SourceGenerator 3.0.2, github.com/martinothamar/Mediator). -->
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Pin i unifikuar i EF Core runtime: provider-i Npgsql 10.0.3 kerkon
         10.0.4 ndersa Design 10.0.10 — pa pin te perbashket MSBuild leshon
         MSB3277 (konflikt versionesh) ne testet qe bashkojne te dy grafet. -->
    <!-- ADR-028 Increment B.1: identity STORE foundation — pins ekzakte.
         Microsoft.AspNetCore.Identity.EntityFrameworkCore 10.0.10 (MIT) =
         store-i EF i ASP.NET Core Identity (roleless ne kete platform);
         OpenIddict.EntityFrameworkCore 7.6.0 (Apache-2.0) = VETEM Core/EF
         store i OpenIddict — ZERO Server/Validation/Client (B.2+). -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- Pin direkt i një varësie TRANSITIVE: AspNetCore.OpenApi 10.0.10 tërheq
         Microsoft.OpenApi 2.0.0 me vulnerabilitet HIGH të njohur
         (GHSA-v5pm-xwqc-g5wc); 2.11.0 është versioni i linjës 2.x me fix. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.6.0" />
    <!-- ADR-028 Increment B.2a: OpenIddict Server + Validation ASP.NET Core +
         Validation.ServerIntegration 7.6.0 (Apache-2.0) — VETEM keto TRE paketa
         protokolli: Server.AspNetCore -> Server -> Abstractions +
         Microsoft.IdentityModel.JsonWebTokens 8.19.2; Validation.AspNetCore ->
         Validation -> + Microsoft.IdentityModel.Protocols 8.19.2;
         Validation.ServerIntegration (UseLocalServer per API + authority
         co-located) -> Server + Validation. ZERO OpenIddict.AspNetCore
         (metapackage: terheq Client), ZERO Client, ZERO DataProtection/Quartz/
         SystemNetHttp. Owner i vetem = Modules/Identity/Infrastructure
         (architecture tests). Provenance: nuspec zyrtar 7.6.0 + reflection mbi
         binaret e restauruara (B.2a Record). -->
    <PackageVersion Include="OpenIddict.Server.AspNetCore" Version="7.6.0" />
    <PackageVersion Include="OpenIddict.Validation.AspNetCore" Version="7.6.0" />
    <PackageVersion Include="OpenIddict.Validation.ServerIntegration" Version="7.6.0" />
    <!-- ADR-029 Increment A: Scalar API reference UI (vetem Development). -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.16" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>
