<Project Sdk="Microsoft.NET.Sdk">
  <!-- Persistence: MIGRATION OWNER I VETËM i platform DB-së (ADR-024 "Një
       migration owner"). NEUTRAL ndaj moduleve — modelon vetëm storage
       records POCO; NUK referon asnjë Domain moduli (mbyll varësinë
       transitive PlatformStatus → Persistence → AccessControl.Domain).
       Çdo modul mapon records ↔ tipet e veta në Infrastructure-in e vet. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- ADR-028 B.1: provider-specific STORAGE mapping jeton ne Persistence
         (migration owner i vetem): konteksti roleless IdentityUserContext +
         entitetet OpenIddict Core/EF me celesa Guid. ZERO protokoll ketu. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" />
  </ItemGroup>
</Project>
